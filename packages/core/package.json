{
  "name": "@xunserver-jsf/core",
  "version": "1.1.0",
  "description": "Framework-agnostic JSON Schema form engine: definition, compile, transactional runtime, and validation.",
  "keywords": [
    "json-schema",
    "form",
    "compiler",
    "runtime",
    "validation"
  ],
  "license": "MIT",
  "author": "xunserver",
  "homepage": "https://xunserver.github.io/json-schema-form/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunserver/json-schema-form.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xunserver/json-schema-form/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
