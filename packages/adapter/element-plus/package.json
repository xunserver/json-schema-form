{
  "name": "@xunserver-jsf/element-plus",
  "version": "1.0.1",
  "description": "Element Plus UI adapter for @xunserver-jsf/vue.",
  "keywords": [
    "json-schema",
    "form",
    "vue",
    "element-plus"
  ],
  "license": "MIT",
  "author": "xunserver",
  "homepage": "https://xunserver.github.io/json-schema-form/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunserver/json-schema-form.git",
    "directory": "packages/adapter/element-plus"
  },
  "bugs": {
    "url": "https://github.com/xunserver/json-schema-form/issues"
  },
  "type": "module",
