    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@xunserver-jsf/core": "workspace:*",
    "@xunserver-jsf/vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.8.0"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.8.0"
  }
