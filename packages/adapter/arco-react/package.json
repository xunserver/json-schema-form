{
  "name": "@xunserver-jsf/arco-react",
  "version": "1.0.1",
  "description": "Arco Design React UI adapter for @xunserver-jsf/react.",
  "keywords": [
    "json-schema",
    "form",
    "react",
    "arco-design"
  ],
  "license": "MIT",
  "author": "xunserver",
  "homepage": "https://xunserver.github.io/json-schema-form/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xunserver/json-schema-form.git",
    "directory": "packages/adapter/arco-react"
  },
  "bugs": {
    "url": "https://github.com/xunserver/json-schema-form/issues"
  },
