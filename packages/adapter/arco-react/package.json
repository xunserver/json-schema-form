  },
  "peerDependencies": {
    "react": "^19.0.0 || ^18.0.0",
    "@arco-design/web-react": "^2.0.0"
  },
  "devDependencies": {
    "@arco-design/web-react": "^2.0.0",
    "@types/react": "^19.0.0",
