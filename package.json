{
  "name": "json-schema-form",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p packages/core/tsconfig.type-tests.json --pretty false && tsc --noEmit -p packages/vue/tsconfig.type-tests.json --pretty false && tsc --noEmit -p packages/react/tsconfig.type-tests.json --pretty false && tsc --noEmit -p tests/contracts/positive/tsconfig.json --pretty false",
    "test": "vitest run",
    "check:boundaries": "tsx tools/architecture-check/cli.ts",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm example:vue && pnpm example:react",
    "example:vue": "pnpm --filter @form/example-vue-element-plus typecheck && tsx examples/vue-element-plus/src/smoke.ts",
    "example:react": "pnpm --filter @form/example-react-mui typecheck && tsx examples/react-mui/src/smoke.ts"
  },
  "devDependencies": {
    "@form/core": "workspace:*",
    "@form/element-plus": "workspace:*",
    "@form/mui": "workspace:*",
    "@form/react": "workspace:*",
    "@form/validator-ajv": "workspace:*",
    "@form/vue": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.2.0",
    "@vue/test-utils": "^2.4.6",
    "element-plus": "^2.8.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vue": "^3.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
